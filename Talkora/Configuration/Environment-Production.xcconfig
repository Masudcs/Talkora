// Environment-Production.xcconfig
// Values specific to the Production environment.

PRODUCT_BUNDLE_IDENTIFIER = com.talkora.app
PRODUCT_NAME = Talkora
// The TALKORA_* values below reach Info.plist and are read at runtime by `AppEnvironment`.
TALKORA_APP_DISPLAY_NAME = Talkora
TALKORA_ENVIRONMENT_NAME = production
// `\/` escapes the slashes: a bare `//` would start an xcconfig comment and truncate the URL.
TALKORA_API_BASE_URL = https:\/\/mock.talkora.local
TALKORA_ENABLE_LOGGING = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
