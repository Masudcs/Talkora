// Environment-Staging.xcconfig
// Values specific to the Staging environment.

PRODUCT_BUNDLE_IDENTIFIER = com.talkora.app.staging
PRODUCT_NAME = Talkora Staging
// The TALKORA_* values below reach Info.plist and are read at runtime by `AppEnvironment`.
TALKORA_APP_DISPLAY_NAME = Talkora Staging
TALKORA_ENVIRONMENT_NAME = staging
// `\/` escapes the slashes: a bare `//` would start an xcconfig comment and truncate the URL.
TALKORA_API_BASE_URL = https:\/\/mock.staging.talkora.local
TALKORA_ENABLE_LOGGING = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Staging
